# Copy to .env and fill in, then run with: uv run --env-file .env pytest ...

# Board per profile. A profile without a port is skipped with --profiles=all.
TEST_SERIAL_PORT_HOST=socket://localhost
TEST_SERIAL_PORT_ESP32=/dev/ttyUSB0
TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM0
TEST_SERIAL_PORT_CH32V307=/dev/ttyACM2
TEST_SERIAL_PORT_PICOW=/dev/ttyACM3

# Wi-Fi for the on-board network tests (passed to sketches as WIFI_SSID / WIFI_PASSWORD).
# The PC must reach the boards on this network, and they the PC (client_interop).
TEST_WIFI_SSID=your-ssid
TEST_WIFI_PASSWORD=your-password
TEST_SERIAL_PORT_ESP32P4=/dev/ttyUSB1
